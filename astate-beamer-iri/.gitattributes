# Files excluded from `quarto use template` scaffolds (kept in the repo for
# development, but not shipped when a user scaffolds a new project).
#
# Note: Makefile and README.md DO ship — users get the same build helpers
# and docs as the dev repo.
.gitignore        export-ignore
.gitattributes    export-ignore
.claude/          export-ignore
.DS_Store         export-ignore
example.tex       export-ignore
_output/          export-ignore
